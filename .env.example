# Flask Configuration
FLASK_DEBUG=false
PORT=5000
MAX_CONTENT_LENGTH=1048576

# CORS - comma-separated allowed origins
CORS_ORIGINS=http://localhost:80

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_LOG_LEVEL=info

# Model Directory
MODEL_DIR=models

# Log Level
LOG_LEVEL=INFO
